 echo "══ 1/3 apply schema → D1 $REVIEW_D1(--remote)══"
 npx wrangler d1 execute "$REVIEW_D1" --remote --file=apps/api/schema.sql --config "$API_CFG"
 
+# 🔴 **schema.sql 之后必须再跑一遍 migrations。**
+#    `CREATE TABLE IF NOT EXISTS` 对【已存在的表】是 no-op —— 它不补列。
+#    所以给已有表加的每一列(shares.page_json / render_jobs.client_job_id / …)
+#    都只存在于 migrations/ 里,不跑就是「表在、列不在」,而症状是运行时
+#    `no such column: xxx`,不是部署失败 —— 这个洞 2026-08-07 一天之内咬了两次。
+#    ⚠️ ALTER 不幂等,重跑必报 duplicate column —— 所以这里【只把它当噪声吞掉】,
+#       不能用 set -e 让它中断部署。真正的解法是 FU-19 的 schema_migrations 账本 + 有序 runner。
+echo "══ 1b/3 apply migrations(已跑过的会报 duplicate column,属正常)══"
+for f in apps/api/migrations/*.sql; do
+  if npx wrangler d1 execute "$REVIEW_D1" --remote --file="$f" --config "$API_CFG" >/tmp/mig.$$.log 2>&1; then
+    echo "   ✓ $(basename "$f")"
+  elif grep -qiE "duplicate column|already exists" /tmp/mig.$$.log; then
+    echo "   · $(basename "$f") 已跑过,跳过"
+  else
+    echo "   ✗ $(basename "$f") 失败:" >&2; tail -5 /tmp/mig.$$.log >&2; rm -f /tmp/mig.$$.log; exit 1
+  fi
+  rm -f /tmp/mig.$$.log
+done
+
 echo "══ 2/3 deploy Worker $REVIEW_WORKER(--env review)══"
 npx wrangler deploy --env review --config "$API_CFG"
 

