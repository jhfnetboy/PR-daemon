+++ b/apps/api/src/persist-all.test.ts
@@ -0,0 +1,105 @@
+/**
+ * 「图必须落库,不管是缩略图还是照片级」—— 2026-08-08。跑:npx tsx apps/api/src/persist-all.test.ts
+ *
+ * 量三件事,每一件都对应一个客户看得见的症状:
+ *   ① /render-finishes 建的行【有 owner】—— 否则 /render-result 的落库分支根本不进,
+ *      回退到历史对话时那一排缩略图全是灰的(上一版就是这样,而注释说的是「不进我的出图」)。
+ *   ② 它【不出现在 /my-renders】—— 一次四张,画廊会被淹掉。
+ *   ③ 交付图【照常出现在 /my-renders】—— 别为了修 ① 把画廊也塞满。
+ *
+ * ⚠️ 断言打在**响应体**和**库里的行**上,不打在我以为的函数返回值上。
+ */
+import { DatabaseSync } from 'node:sqlite';
+import { readFileSync } from 'node:fs';
+import worker from './index';
+
+function d1(db: any): any {
+  return {
+    prepare(sql: string) {
+      return { sql, _a: [] as any[], bind(...a: any[]) { this._a = a; return this; },
+        async first() { return db.prepare(this.sql).get(...this._a) ?? null; },
+        async run() { const r = db.prepare(this.sql).run(...this._a); return { meta: { changes: r.changes } }; },
+        async all() { return { results: db.prepare(this.sql).all(...this._a) }; } };
+    },
+    async batch(sts: any[]) { const o = []; for (const s of sts) o.push(await s.run()); return o; },
+  };
+}
+
+let pass = 0, fail = 0;
+const ok = (n: string, c: boolean, d = '') => { c ? (pass++, console.log('  ✅ ' + n)) : (fail++, console.error('  ❌ ' + n + ' ' + d)); };
+
+const NOW = Date.now();
+const SESS = 'sess-u1-aaaaaaaaaaaaaaaaaaaaaaaa';
+const ORIGIN = 'https://review.test';
+
+function seed() {
+  const raw = new DatabaseSync(':memory:');
+  raw.exec(readFileSync('apps/api/schema.sql', 'utf8'));
+  raw.exec(`INSERT INTO users (id,name,role,email,active,pending,created_at)
+    VALUES ('u1','客户','customer','buyer@cmic.test',1,0,${NOW})`);
+  raw.exec(`INSERT INTO sessions (token,user_id,created_at,expires_at)
+    VALUES ('${SESS}','u1',${NOW},${NOW + 86_400_000})`);
+  return raw;
+}
+
+const ctx = { waitUntil() { /* noop */ }, passThroughOnException() { /* noop */ } } as any;
+
+async function hit(env: any, method: string, path: string, body?: unknown) {
+  const h: Record<string, string> = { 'CF-Connecting-IP': '1.2.3.4', cookie: `cmic_sess=${SESS}`, origin: ORIGIN };
+  const raw = body === undefined ? undefined : JSON.stringify(body);
+  if (raw !== undefined) { h['content-type'] = 'application/json'; h['content-length'] = String(new TextEncoder().encode(raw).length); }
+  const res = await worker.fetch(new Request('https://api.test' + path, { method, headers: h, body: raw }), env, ctx);
+  const text = await res.text();
+  let json: any = null; try { json = JSON.parse(text); } catch { /* 二进制 */ }
+  return { status: res.status, text, json };
+}
+
+async function main() {
+  console.log('图必须落库(缩略图 + 照片级):');
+  const raw = seed();
+
+  // Modal 的 submit 用 fetch 打过去 —— 拦住它,回一个固定 call_id。
+  const realFetch = globalThis.fetch;
+  globalThis.fetch = (async () => new Response(JSON.stringify({ call_id: 'fc-TEST-1' }), {
+    status: 200, headers: { 'content-type': 'application/json' },
+  })) as any;
+
+  const env = {
+    DB: d1(raw), RENDERS: undefined,
+    ADMIN_TOKEN: 'admin-token-xxxxxxxxxxxxxxxxxxxx',
+    APP_URL: ORIGIN, ALLOWED_ORIGINS: ORIGIN,
+    RENDER_URL: 'https://x--cmic-render-render-endpoint.modal.run', RENDER_TOKEN: 'rt',
+  } as any;
+
+  const made = await hit(env, 'POST', '/render-finishes', {
+    box_type: 'lidbase', box_glb: 'Z2xiLXN0dWI=', box_dims: [250, 180, 60],
+    product: 'watch', color: '#b08247', finishes: ['v1', 'v2'],
+  });
+  globalThis.fetch = realFetch;
+  ok('POST /render-finishes 建任务成功', made.status === 200, `status=${made.status} ${made.text.slice(0, 160)}`);
+
+  const row = raw.prepare("SELECT owner_user_id, kind FROM render_jobs WHERE call_id='fc-TEST-1'").get() as any;
+  // 🔴 变异对照:把 finOwner 改回 NULL,这条必红 —— 而它红了才等于「历史对话回退时缩略图还在」。
+  ok('① 工艺缩略图的行【有 owner】(否则 /render-result 的落库分支根本不进)',
+    row?.owner_user_id === 'u1', `owner=${row?.owner_user_id}`);
+  ok('  且被标成 kind=finishes', row?.kind === 'finishes', `kind=${row?.kind}`);
+
+  // 假装它已经交付(persistRender 会做的事),再看画廊
+  raw.exec(`UPDATE render_jobs SET delivered_at=${NOW}, r2_prefix='renders/fc-TEST-1/', views='["open"]' WHERE call_id='fc-TEST-1'`);
+  // 一条真正的交付图
+  raw.exec(`INSERT INTO render_jobs (call_id,user_id,result_token,owner_user_id,box_type,product,r2_prefix,views,delivered_at,created_at)
+    VALUES ('deliv-1','u1','tok','u1','lidbase','Watch','renders/deliv-1/','["open"]',${NOW},${NOW})`);
+
+  // ⚠️ 下面两条不能【空真】:行都没建成的话「不在画廊里」是白拿的。先钉住它存在。
+  const cnt = (raw.prepare("SELECT COUNT(*) n FROM render_jobs WHERE call_id='fc-TEST-1'").get() as any).n;
+  ok('  (前提)缩略图那一行确实落库了', cnt === 1, `count=${cnt}`);
+
+  const gal = await hit(env, 'GET', '/my-renders');
+  const ids = (gal.json?.renders ?? []).map((r: any) => r.call_id);
+  ok('② 缩略图【不进】我的出图(一次四张,会把画廊淹掉)', !ids.includes('fc-TEST-1'), JSON.stringify(ids));
+  ok('③ 交付图【照常进】我的出图(别为了修①把画廊也清空)', ids.includes('deliv-1'), JSON.stringify(ids));
+
+  console.log(`\n${fail ? '❌' : '✅'} persist-all: ${pass} 通过, ${fail} 失败`);
+  if (fail) process.exit(1);
+}
+void main();
